# Modele de secrets prod. Copier vers .env.prod.local (jamais
# committe) et renseigner avant tout demarrage :
#   cp .env.prod.local.dist .env.prod.local
#   docker compose -f compose.yml -f compose.prod.yml --env-file .env.prod.local up -d --wait

PHP_VERSION=8.5
FRANKENPHP_VERSION=1.13.0
PHP_EXTENSION_INSTALLER_VERSION=2.12.0
POSTGRES_VERSION=18
EMBER_VERSION=1.6.1
TARGET=prod
# Suffixe des noms de conteneurs, du reseau et des volumes (section 2) :
# c'est lui qui permet a cet environnement de cohabiter avec les autres
# sur un meme hote. Ne jamais le laisser vide.
ENV=prod
USER_ID=1000
GROUP_ID=1000
HTTP_PORT=80
HTTPS_PORT=443
HTTP3_PORT=443
EMBER_PORT=9191
RUN_MIGRATIONS=0
POSTGRES_DB=app
POSTGRES_USER=app
POSTGRES_PASSWORD=

# Proxies de confiance (section 4) : le proxy est joint par le reseau
# Docker, dont l'adresse change a chaque redemarrage. Sans cette
# valeur, Symfony fabrique toutes ses URL en http:// sur un site en
# https, et rien ne le signale — le conteneur reste healthy.
SYMFONY_TRUSTED_PROXIES=private_ranges

# Emails (section 8b). Quelques formes de DSN courantes :
#   smtp://utilisateur:motdepasse@smtp.exemple.fr:587
#   sendmail://default          (MTA local sur la machine)
# L'adresse expeditrice doit appartenir au domaine exactement
# authentifie chez le fournisseur — un sous-domaine n'herite pas de
# l'authentification de son parent, meme quand il en herite cote DNS.
MAILER_DSN=
MAILER_FROM=

# Variables obligatoires (${VAR:?...}) — jamais dans le .env racine.
APP_SECRET=
SERVER_NAME=
