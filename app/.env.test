# define your env variables for the test env here
KERNEL_CLASS='App\Kernel'
APP_SECRET='$ecretf0rt3st'

# Injectees par compose.yml en conteneur, absentes hors conteneur : sans
# elles, la compilation du conteneur echoue sur « Environment variable not
# found » (conventions, section 8b). Valeurs inertes : un test ne joint
# personne.
DATABASE_URL=postgresql://app:app@127.0.0.1:5432/app?charset=utf8
MAILER_DSN=null://null
MAILER_FROM=noreply@localhost
