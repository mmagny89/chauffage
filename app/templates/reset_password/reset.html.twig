{% extends 'base.html.twig' %}

{% block title %}Nouveau mot de passe{% endblock %}

{% block body %}
{% import 'partials/_icon.html.twig' as ui %}
<section class="mx-auto max-w-md rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
    <h1 class="mb-6 flex items-center gap-2 text-2xl font-semibold"><span class="text-amber-600">{{ ui.icon('key', 'size-7') }}</span>Nouveau mot de passe</h1>

    {{ form_start(resetForm, {attr: {novalidate: 'novalidate'}}) }}
        {{ form_row(resetForm.plainPassword.first) }}
        {{ form_row(resetForm.plainPassword.second) }}
        {% include 'partials/_button.html.twig' with {label: 'Enregistrer', icon: 'check'} %}
    {{ form_end(resetForm) }}
</section>
{% endblock %}
