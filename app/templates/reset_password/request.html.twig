{% extends 'base.html.twig' %}

{% block title %}Mot de passe oublié{% endblock %}

{% block body %}
{% import 'partials/_icon.html.twig' as ui %}
<section class="mx-auto max-w-md rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
    <h1 class="mb-2 flex items-center gap-2 text-2xl font-semibold"><span class="text-amber-600">{{ ui.icon('key', 'size-7') }}</span>Mot de passe oublié</h1>
    <p class="mb-6 text-sm text-slate-600">Indiquez votre adresse : si un compte existe, vous recevrez un lien pour choisir un nouveau mot de passe.</p>

    {{ form_start(requestForm, {attr: {novalidate: 'novalidate'}}) }}
        {{ form_row(requestForm.email) }}
        {% include 'partials/_button.html.twig' with {label: 'Envoyer le lien', icon: 'mail'} %}
    {{ form_end(requestForm) }}
</section>
{% endblock %}
