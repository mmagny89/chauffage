<!DOCTYPE html>
<html lang="fr" class="h-full">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        {% set csp_nonce = app.request.attributes.get('csp_nonce') %}
        {# Turbo lit ce nonce pour poser sa barre de progression sans « unsafe-inline ». #}
        <meta name="csp-nonce" content="{{ csp_nonce }}">
        <title>{% block title %}Chauffage{% endblock %} · Chauffage</title>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>🔥</text></svg>">
        <link rel="stylesheet" href="{{ asset('styles/app.css') }}">
        {% block stylesheets %}{% endblock %}
        {% block javascripts %}
            {% block importmap %}{{ importmap('app', {nonce: csp_nonce}) }}{% endblock %}
        {% endblock %}
    </head>
    <body class="flex min-h-full flex-col bg-slate-50 font-sans text-slate-900 antialiased">
        <a href="#contenu" class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded focus:bg-white focus:px-3 focus:py-2 focus:shadow">Aller au contenu</a>

        {% include 'partials/_header.html.twig' %}

        <main id="contenu" class="mx-auto w-full max-w-5xl flex-1 px-4 py-6 sm:py-8">
            {% for type, messages in app.flashes %}
                {% for message in messages %}
                    <div role="{{ type == 'error' ? 'alert' : 'status' }}" class="mb-6 rounded-md border px-4 py-3 text-sm {{ type == 'error' ? 'border-red-300 bg-red-50 text-red-900' : (type == 'info' ? 'border-sky-300 bg-sky-50 text-sky-950' : 'border-emerald-300 bg-emerald-50 text-emerald-900') }}">{{ message }}</div>
                {% endfor %}
            {% endfor %}

            {% block body %}{% endblock %}
        </main>

        <footer class="border-t border-slate-200 bg-white">
            <div class="mx-auto flex max-w-5xl flex-col gap-1 px-4 py-4 text-xs text-slate-600 sm:flex-row sm:justify-between">
                <p>Chauffage · projet personnel de <a href="https://github.com/mmagny89" class="underline underline-offset-2">mmagny89</a> · <a href="https://github.com/mmagny89/chauffage" class="underline underline-offset-2">Code source sur GitHub</a></p>
                <p>Météo : <a href="https://open-meteo.com/" class="underline underline-offset-2">Open-Meteo</a> (<a href="https://creativecommons.org/licenses/by/4.0/" class="underline underline-offset-2">CC BY 4.0</a>) · localisation : GeoNames</p>
            </div>
        </footer>
    </body>
</html>
