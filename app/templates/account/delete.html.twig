{% extends 'base.html.twig' %}

{% block title %}Supprimer mon compte{% endblock %}

{% block body %}
{% import 'partials/_icon.html.twig' as ui %}
<h1 class="mb-2 flex items-center gap-2 text-2xl font-semibold"><span class="text-red-700">{{ ui.icon('trash', 'size-7') }}</span>Supprimer mon compte</h1>
<p class="mb-6 max-w-xl text-slate-700">La suppression est <strong>définitive</strong> : votre compte, votre foyer, vos lieux, vos relevés et vos allumages sont effacés, sans sauvegarde. Vous pouvez d’abord <a href="{{ path('app_account_export') }}" class="underline underline-offset-2">télécharger vos données</a>.</p>

<section aria-labelledby="confirmation" class="max-w-md rounded-xl border border-red-200 bg-white p-6 shadow-sm">
    <h2 id="confirmation" class="mb-4 text-lg font-semibold">Confirmer</h2>
    {{ form_start(form, {attr: {novalidate: 'novalidate'}}) }}
        {{ form_row(form.currentPassword) }}
        {{ form_row(form.confirm) }}
        <button type="submit" class="inline-flex min-h-11 w-full items-center justify-center gap-2 rounded-md bg-red-700 px-4 py-2 font-medium text-white hover:bg-red-800 focus:outline-2 focus:outline-offset-2 focus:outline-red-800">{{ ui.icon('trash') }}Supprimer définitivement mon compte</button>
    {{ form_end(form) }}
    <p class="mt-4 text-sm"><a href="{{ path('app_account') }}" class="inline-flex min-h-11 items-center underline underline-offset-2">Annuler</a></p>
</section>
{% endblock %}
