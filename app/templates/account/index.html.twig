{% extends 'base.html.twig' %}

{% block title %}Mon compte{% endblock %}

{% block body %}
{% import 'partials/_icon.html.twig' as ui %}
<h1 class="mb-1 flex items-center gap-2 text-2xl font-semibold"><span class="text-amber-600">{{ ui.icon('user', 'size-7') }}</span>Mon compte</h1>
<p class="mb-6 text-slate-700">Adresse de connexion : <strong>{{ email }}</strong></p>

<section aria-labelledby="mot-de-passe" class="max-w-md rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
    <h2 id="mot-de-passe" class="mb-4 flex items-center gap-2 text-lg font-semibold">{{ ui.icon('key', 'size-5') }}Changer de mot de passe</h2>

    {{ form_start(form, {attr: {novalidate: 'novalidate'}}) }}
        {{ form_row(form.currentPassword) }}
        {{ form_row(form.plainPassword.first) }}
        {{ form_row(form.plainPassword.second) }}
        {% include 'partials/_button.html.twig' with {label: 'Enregistrer', icon: 'check'} %}
    {{ form_end(form) }}
</section>

<section aria-labelledby="donnees" class="mt-8 max-w-md rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
    <h2 id="donnees" class="mb-2 flex items-center gap-2 text-lg font-semibold">{{ ui.icon('info', 'size-5') }}Mes données</h2>
    <p class="mb-4 text-sm text-slate-700">Téléchargez tout ce que l’application conserve à votre sujet (adresse, ville, lieux, températures visées, relevés, allumages) dans un fichier JSON.</p>
    <a href="{{ path('app_account_export') }}" class="inline-flex min-h-11 items-center gap-2 rounded-md border border-slate-500 bg-white px-4 py-2 font-medium text-slate-900 hover:bg-slate-100 focus:outline-2 focus:outline-offset-2 focus:outline-slate-900">{{ ui.icon('arrowright') }}Télécharger mes données</a>
</section>

<section aria-labelledby="suppression" class="mt-8 max-w-md rounded-xl border border-red-200 bg-white p-6 shadow-sm">
    <h2 id="suppression" class="mb-2 flex items-center gap-2 text-lg font-semibold text-red-800">{{ ui.icon('trash', 'size-5') }}Supprimer mon compte</h2>
    <p class="mb-4 text-sm text-slate-700">Efface définitivement votre compte et toutes vos données.</p>
    <a href="{{ path('app_account_delete') }}" class="inline-flex min-h-11 items-center gap-2 rounded-md border border-red-700 bg-white px-4 py-2 font-medium text-red-800 hover:bg-red-50 focus:outline-2 focus:outline-offset-2 focus:outline-red-800">Supprimer mon compte…</a>
</section>
{% endblock %}
