{% if delta.average is null %}
    <span aria-label="aucun relevé">—</span>
{% else %}
    <span class="whitespace-nowrap font-medium">{{ delta.average > 0 ? '+' : '' }}{{ delta.average|number_format(1, ',') }} °C</span>
    <span class="block whitespace-nowrap text-xs text-slate-500">{{ delta.count }} relevé{{ delta.count > 1 ? 's' : '' }}</span>
{% endif %}
