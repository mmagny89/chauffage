<td class="px-4 py-3 align-top">{{ model.readings }} <span class="block text-xs text-slate-500">{{ model.sessions }} instant{{ model.sessions > 1 ? 's' : '' }} distinct{{ model.sessions > 1 ? 's' : '' }}</span></td>
<td class="px-4 py-3 align-top">{% if model.outdoorMin == model.outdoorMax %}{{ model.outdoorMin|number_format(1, ',') }} °C{% else %}{{ model.outdoorMin|number_format(1, ',') }} à {{ model.outdoorMax|number_format(1, ',') }} °C{% endif %}</td>
<td class="px-4 py-3 align-top">
    {% if model.kind.value == 'regression' %}<span class="font-medium">Pente mesurée</span>{% else %}<span class="font-medium">Pente typique</span>{% endif %}
    : écart = {{ model.intercept|number_format(1, ',') }} {{ model.slope < 0 ? '−' : '+' }} {{ model.slope|abs|number_format(2, ',') }} × T° extérieure
    <span class="block text-xs text-slate-500">soit intérieur ≈ {{ model.intercept|number_format(1, ',') }} + {{ (1 + model.slope)|number_format(2, ',') }} × T° extérieure</span>
    <span class="block text-xs text-slate-500">
        {% if model.kind.value == 'regression' %}Les relevés pèsent pour {{ (model.dataWeight * 100)|round }} % dans la pente.
        {% else %}Trop peu de relevés, ou à des températures trop proches, pour mesurer la pente : elle est surtout la pente typique ({{ typicalSlope|number_format(2, ',') }}), recalée sur vos relevés (ils pèsent pour {{ (model.dataWeight * 100)|round }} %).{% endif %}
    </span>
</td>
