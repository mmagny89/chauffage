{% extends 'base.html.twig' %}

{% block title %}Écarts{% endblock %}

{% block body %}
<h1 class="mb-2 text-2xl font-semibold">Écarts de température</h1>
<p class="mb-6 text-slate-700">Écart moyen entre la température intérieure et la température extérieure : plus il est élevé, mieux la pièce garde la chaleur. Il sert ensuite à estimer la température intérieure à partir des prévisions. Il n’est juste que si les relevés ont été faits <strong>chauffage éteint</strong>.</p>

{% if report.empty %}
    <div class="rounded-lg border border-slate-200 bg-white p-6">
        <p class="mb-4 text-slate-700">Aucun relevé pour le moment : il n’y a rien à calculer.</p>
        <a href="{{ path('app_readings') }}" class="inline-block rounded-md bg-slate-900 px-4 py-2 font-medium text-white hover:bg-slate-700 focus:outline-2 focus:outline-offset-2 focus:outline-slate-900">Saisir des relevés</a>
    </div>
{% else %}
    {% if daysDone < daysRequired %}
        <div role="status" class="mb-6 rounded-md border border-amber-300 bg-amber-50 px-4 py-3 text-sm text-amber-900">
            Résultats provisoires : {{ daysDone }} jour{{ daysDone > 1 ? 's' : '' }} de relevés sur {{ daysRequired }} recommandés.
            <a href="{{ path('app_readings') }}" class="underline underline-offset-2">Ajouter des relevés</a>
        </div>
    {% endif %}

    <div class="overflow-x-auto rounded-lg border border-slate-200 bg-white">
        <table class="w-full text-left text-sm">
            <caption class="sr-only">Écart moyen intérieur moins extérieur, par lieu et par créneau de la journée</caption>
            <thead class="bg-slate-100 text-slate-700">
                <tr>
                    <th scope="col" class="px-4 py-3 font-semibold">Lieu</th>
                    <th scope="col" class="px-4 py-3 text-right font-semibold">Moyenne</th>
                    {% for slot in slots %}
                        <th scope="col" class="px-4 py-3 text-right font-semibold">{{ slot.label }}</th>
                    {% endfor %}
                </tr>
            </thead>
            <tbody>
                {% for place in report.places %}
                    <tr class="border-t border-slate-100">
                        <th scope="row" class="px-4 py-3 font-medium">{{ place.placeName }}</th>
                        <td class="px-4 py-3 text-right">{% include 'delta/_cell.html.twig' with {delta: place.overall} %}</td>
                        {% for slot in slots %}
                            <td class="px-4 py-3 text-right">{% include 'delta/_cell.html.twig' with {delta: place.forSlot(slot)} %}</td>
                        {% endfor %}
                    </tr>
                {% endfor %}
            </tbody>
            <tfoot>
                <tr class="border-t border-slate-300 bg-slate-50">
                    <th scope="row" class="px-4 py-3 font-semibold">{{ report.household.placeName }}</th>
                    <td class="px-4 py-3 text-right">{% include 'delta/_cell.html.twig' with {delta: report.household.overall} %}</td>
                    {% for slot in slots %}
                        <td class="px-4 py-3 text-right">{% include 'delta/_cell.html.twig' with {delta: report.household.forSlot(slot)} %}</td>
                    {% endfor %}
                </tr>
            </tfoot>
        </table>
    </div>
    <p class="mt-3 text-sm text-slate-600">Un « — » signale un créneau sans relevé : plus le nombre de relevés est faible, moins la moyenne est fiable.</p>
{% endif %}
{% endblock %}
