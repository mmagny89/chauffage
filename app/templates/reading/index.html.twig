{% extends 'base.html.twig' %}

{% block title %}Relevés{% endblock %}

{% block body %}
{% import 'partials/_icon.html.twig' as ui %}
<h1 class="mb-2 flex items-center gap-2 text-2xl font-semibold"><span class="text-amber-600">{{ ui.icon('thermometer', 'size-7') }}</span>Relevés de température</h1>
<p class="mb-4 text-slate-700">Notez, à une même heure, la température extérieure et celle de chacun de vos lieux. L’outil en déduira l’écart moyen de chaque lieu.</p>

<aside role="note" aria-labelledby="sans-chauffage" class="mb-6 flex items-start gap-3 rounded-lg border border-sky-300 bg-sky-50 p-4 text-sm text-sky-950">
    <span class="mt-0.5">{{ ui.icon('power', 'size-5') }}</span>
    <div>
    <h2 id="sans-chauffage" class="mb-1 font-semibold">Relevez les températures chauffage éteint</h2>
    <p>L’outil mesure ce que devient chaque pièce <strong>sans chauffage</strong> par rapport au dehors. Un relevé fait pendant que le chauffage fonctionne fausserait l’écart et donnerait des recommandations trop optimistes. Éteignez-le plusieurs heures avant, et évitez de mesurer au soleil ou près d’une source de chaleur.</p>
    </div>
</aside>

<section aria-labelledby="progression" class="mb-8 rounded-lg border border-slate-200 bg-white p-4">
    <h2 id="progression" class="mb-2 flex items-center gap-2 text-sm font-semibold text-slate-800">{{ ui.icon('target') }}Calibrage</h2>
    {% set done = min(daysDone, daysRequired) %}
    {# Segments plutôt qu'une largeur calculée : pas de style en ligne, donc pas de « unsafe-inline » dans la CSP. #}
    <div role="progressbar" aria-labelledby="progression" aria-valuemin="0" aria-valuemax="{{ daysRequired }}" aria-valuenow="{{ done }}"
         aria-valuetext="{{ daysDone }} jour{{ daysDone > 1 ? 's' : '' }} sur {{ daysRequired }}"
         class="mb-2 flex gap-1">
        {% for step in 1..daysRequired %}
            <span class="h-2 flex-1 rounded {{ step <= done ? 'bg-emerald-600' : 'bg-slate-200' }}"></span>
        {% endfor %}
    </div>
    <p class="text-sm text-slate-700">
        {% if daysDone >= daysRequired %}
            {{ daysDone }} jours renseignés : le calibrage est possible. Ajouter des jours affine la moyenne.
        {% else %}
            {{ daysDone }} jour{{ daysDone > 1 ? 's' : '' }} sur {{ daysRequired }} : encore {{ daysRequired - daysDone }} à renseigner pour calibrer.
        {% endif %}
    </p>
</section>

<section aria-labelledby="ajout" class="mb-10">
    <h2 id="ajout" class="mb-4 flex items-center gap-2 text-lg font-semibold">{{ ui.icon('plus', 'size-5') }}Nouveau relevé</h2>

    {% if form is null %}
        <div class="rounded-lg border border-slate-200 bg-white p-6">
            <p class="mb-4 text-slate-700">Déclarez d’abord les lieux où vous relevez la température (salon, chambre…). Vous renseignerez ensuite chacun d’eux à chaque relevé.</p>
            <a href="{{ path('app_settings', {_fragment: 'lieux'}) }}" class="inline-block rounded-md bg-slate-900 px-4 py-2 font-medium text-white hover:bg-slate-700 focus:outline-2 focus:outline-offset-2 focus:outline-slate-900">Déclarer mes lieux</a>
        </div>
    {% else %}
        {{ form_start(form, {attr: {novalidate: 'novalidate'}}) }}
            {{ form_errors(form) }}
            <div class="grid max-w-2xl gap-x-4 sm:grid-cols-3">
                {{ form_row(form.date) }}
                {{ form_row(form.time) }}
                {{ form_row(form.outdoor) }}
            </div>

            <fieldset class="mb-6 max-w-2xl rounded-lg border border-slate-200 bg-white p-4">
                <legend class="px-1 text-sm font-semibold text-slate-800">{{ ui.icon('home', 'inline size-4 align-text-bottom') }} Température intérieure de chaque lieu (°C)</legend>
                <p class="mb-3 text-sm text-slate-600">Tous les lieux sont à renseigner. <a href="{{ path('app_settings', {_fragment: 'lieux'}) }}" class="underline underline-offset-2">Modifier la liste des lieux</a></p>
                <div id="releve-interieur" class="grid gap-x-4 sm:grid-cols-2">
                    {% for field in form.indoor %}
                        {{ form_row(field) }}
                    {% endfor %}
                </div>
            </fieldset>

            <fieldset class="mb-6 max-w-2xl rounded-lg border border-amber-300 bg-amber-50 p-4">
                <legend class="px-1 text-sm font-semibold text-amber-950">{{ ui.icon('flame', 'inline size-4 align-text-bottom') }} Vous allumez le chauffage juste après ? <span class="font-normal">(facultatif)</span></legend>
                <p class="mb-3 text-sm text-amber-950">Indiquez la consigne réglée dans le lieu concerné : l’allumage est noté à cette heure, avec la température du lieu et la température extérieure ci-dessus. Le relevé reste pris chauffage éteint ; laissez vide ailleurs.</p>
                <div id="allumage" class="grid gap-x-4 sm:grid-cols-2">
                    {% for field in form.heating %}
                        {{ form_row(field, {label: field.vars.label ~ ' : consigne (°C)'}) }}
                    {% endfor %}
                </div>
            </fieldset>

            <div class="max-w-xs">{% include 'partials/_button.html.twig' with {label: 'Enregistrer le relevé', icon: 'check'} %}</div>
        {{ form_end(form) }}
    {% endif %}
</section>

{% if heatingStarts %}
<section id="chauffage" aria-labelledby="titre-chauffage" class="mb-10">
    <h2 id="titre-chauffage" class="mb-2 flex items-center gap-2 text-lg font-semibold"><span class="text-amber-600">{{ ui.icon('flame', 'size-5') }}</span>Allumages du chauffage</h2>
    <p class="mb-4 max-w-2xl text-sm text-slate-700">Notés avec un relevé, quand vous indiquez une consigne. Si vous avez noté un allumage aujourd’hui, les créneaux à venir du jour disent simplement « Chauffer », la consigne étant déjà réglée.</p>
        
        <div class="relative overflow-x-auto rounded-lg border border-slate-200 bg-white">
            <table class="w-full text-left text-sm">
                <caption class="sr-only">Allumages du chauffage : pièce, moment, consigne et température de la pièce</caption>
                <thead class="bg-slate-100 text-slate-700">
                    <tr>
                        <th scope="col" class="px-4 py-2 font-medium">Pièce</th>
                        <th scope="col" class="px-4 py-2 font-medium">Moment</th>
                        <th scope="col" class="px-4 py-2 text-right font-medium">Extérieur</th>
                        <th scope="col" class="px-4 py-2 text-right font-medium">Température de la pièce</th>
                        <th scope="col" class="px-4 py-2 text-right font-medium">Consigne</th>
                        <th scope="col" class="px-4 py-2"><span class="sr-only">Actions</span></th>
                    </tr>
                </thead>
                <tbody>
                    {% for start in heatingStarts %}
                        <tr class="border-t border-slate-100">
                            <th scope="row" class="sticky left-0 bg-white px-4 py-2 font-medium"><span class="inline-flex items-center gap-2">{{ ui.icon(place_icon(start.place.name)) }}{{ start.place.name }}</span></th>
                            <td class="whitespace-nowrap px-4 py-2">{{ start.startedAt|date('d/m/Y à H:i') }}</td>
                            <td class="whitespace-nowrap px-4 py-2 text-right">{{ start.outdoorTemperature is null ? '—' : start.outdoorTemperature|number_format(1, ',') ~ ' °C' }}</td>
                            <td class="whitespace-nowrap px-4 py-2 text-right">{{ start.indoorTemperature|number_format(1, ',') }} °C</td>
                            <td class="whitespace-nowrap px-4 py-2 text-right"><span class="inline-flex items-center gap-1 rounded bg-amber-100 px-2 py-0.5 text-xs font-semibold text-amber-900">{{ ui.icon('flame', 'size-3.5') }}{{ start.setpoint|number_format(1, ',') }} °C</span></td>
                            <td class="px-4 py-2 text-right">
                                <form method="post" action="{{ path('app_heating_start_delete', {id: start.id}) }}">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete-heating-start-' ~ start.id) }}">
                                    <button type="submit" class="inline-flex min-h-11 items-center gap-1.5 rounded px-2 text-slate-700 underline underline-offset-2 hover:text-red-700 focus:outline-2 focus:outline-offset-2 focus:outline-slate-900">
                                        {{ ui.icon('trash') }}Supprimer<span class="sr-only"> l’allumage de {{ start.place.name }} du {{ start.startedAt|date('d/m/Y à H:i') }}</span>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
</section>
{% endif %}

<section aria-labelledby="historique">
    <h2 id="historique" class="mb-4 flex items-center gap-2 text-lg font-semibold">{{ ui.icon('calendar', 'size-5') }}Relevés enregistrés</h2>

    {% for day in days %}
        <div class="mb-6 relative overflow-x-auto rounded-lg border border-slate-200 bg-white">
            <table class="w-full text-left text-sm">
                <caption class="border-b border-slate-200 bg-slate-100 px-4 py-2 text-left font-semibold text-slate-800"><span class="inline-flex items-center gap-2">{{ ui.icon('calendar') }}{{ day.label }}</span></caption>
                <thead class="text-slate-600">
                    <tr>
                        <th scope="col" class="px-4 py-2 font-medium">Lieu</th>
                        <th scope="col" class="px-4 py-2 font-medium">Heure</th>
                        <th scope="col" class="px-4 py-2 font-medium">Créneau</th>
                        <th scope="col" class="px-4 py-2 text-right font-medium">Extérieur</th>
                        <th scope="col" class="px-4 py-2 text-right font-medium">Intérieur</th>
                        <th scope="col" class="px-4 py-2 text-right font-medium">Écart</th>
                        <th scope="col" class="px-4 py-2"><span class="sr-only">Actions</span></th>
                    </tr>
                </thead>
                <tbody>
                    {% for reading in day.readings %}
                        <tr class="border-t border-slate-100">
                            <th scope="row" class="sticky left-0 bg-white px-4 py-2 font-medium"><span class="inline-flex items-center gap-2">{{ ui.icon(place_icon(reading.place.name)) }}{{ reading.place.name }}</span></th>
                            <td class="px-4 py-2">{{ reading.measuredAt|date('H:i') }}</td>
                            <td class="px-4 py-2">{{ reading.slot.label }}</td>
                            <td class="px-4 py-2 text-right">{{ reading.outdoorTemperature|number_format(1, ',') }} °C</td>
                            <td class="px-4 py-2 text-right">{{ reading.indoorTemperature|number_format(1, ',') }} °C</td>
                            <td class="px-4 py-2 text-right">{{ reading.delta > 0 ? '+' : '' }}{{ reading.delta|number_format(1, ',') }} °C</td>
                            <td class="px-4 py-2 text-right">
                                <form method="post" action="{{ path('app_reading_delete', {id: reading.id}) }}">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete-reading-' ~ reading.id) }}">
                                    <button type="submit" class="inline-flex min-h-11 items-center gap-1.5 rounded px-2 text-slate-700 underline underline-offset-2 hover:text-red-700 focus:outline-2 focus:outline-offset-2 focus:outline-slate-900">
                                        {{ ui.icon('trash') }}Supprimer<span class="sr-only"> le relevé de {{ reading.place.name }} à {{ reading.measuredAt|date('H:i') }}</span>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% else %}
        <p class="flex items-center gap-2 rounded-lg border border-dashed border-slate-300 bg-white p-4 text-slate-600">{{ ui.icon('info') }}Aucun relevé pour le moment.</p>
    {% endfor %}
</section>
{% endblock %}
