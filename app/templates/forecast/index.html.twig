{% extends 'base.html.twig' %}

{% block title %}Prévisions{% endblock %}

{% block body %}
<h1 class="mb-2 text-2xl font-semibold">Prévisions de température</h1>

{% if not located %}
    <div class="rounded-lg border border-slate-200 bg-white p-6">
        <p class="mb-4 text-slate-700">Pour afficher les prévisions, indiquez d’abord votre ville.</p>
        <a href="{{ path('app_settings') }}" class="inline-block rounded-md bg-slate-900 px-4 py-2 font-medium text-white hover:bg-slate-700 focus:outline-2 focus:outline-offset-2 focus:outline-slate-900">Choisir ma ville</a>
    </div>
{% elseif error %}
    <p role="alert" class="rounded-md border border-red-300 bg-red-50 px-4 py-3 text-sm text-red-900">{{ error }}</p>
{% else %}
    <p class="mb-6 text-slate-700">Température extérieure prévue à <strong>{{ household.city }}</strong>, sur {{ rows|length }} jours, par moment de la journée. Au-delà d’une semaine, les prévisions sont de moins en moins fiables.</p>

    <div class="overflow-x-auto rounded-lg border border-slate-200 bg-white">
        <table class="w-full text-left text-sm">
            <caption class="sr-only">Température extérieure prévue, moyenne puis minimum et maximum, par jour et par moment de la journée</caption>
            <thead class="bg-slate-100 text-slate-700">
                <tr>
                    <th scope="col" class="px-4 py-3 font-semibold">Jour</th>
                    {% for slot in slots %}
                        <th scope="col" class="px-4 py-3 text-right font-semibold">{{ slot.label }}</th>
                    {% endfor %}
                </tr>
            </thead>
            <tbody>
                {% for row in rows %}
                    <tr class="border-t border-slate-100">
                        <th scope="row" class="whitespace-nowrap px-4 py-3 font-medium">{{ row.label }}</th>
                        {% for slot in slots %}
                            {% set forecast = row.day.forSlot(slot) %}
                            <td class="px-4 py-3 text-right">
                                {% if forecast.hasData %}
                                    <span class="font-medium">{{ forecast.average|number_format(1, ',') }} °C</span>
                                    <span class="block text-xs text-slate-500">{{ forecast.min|number_format(0, ',') }} à {{ forecast.max|number_format(0, ',') }} °C{% if not forecast.complete %} <span title="Prévision incomplète sur ce créneau">*</span>{% endif %}</span>
                                {% else %}
                                    <span aria-label="pas de prévision">—</span>
                                {% endif %}
                            </td>
                        {% endfor %}
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
    <p class="mt-3 text-sm text-slate-600">La nuit d’un jour va de 22 h ce jour-là à 6 h le lendemain. « * » : créneau dont toutes les heures ne sont pas encore prévues.</p>
    <p class="mt-2 text-xs text-slate-500"><a href="https://open-meteo.com/" class="underline underline-offset-2">Weather data by Open-Meteo.com</a> (licence <a href="https://creativecommons.org/licenses/by/4.0/" class="underline underline-offset-2">CC BY 4.0</a>).</p>
{% endif %}
{% endblock %}
