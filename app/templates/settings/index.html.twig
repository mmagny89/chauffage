{% extends 'base.html.twig' %}

{% block title %}{{ setup ? 'Mise en route' : 'Réglages' }}{% endblock %}

{% block body %}
{% import 'partials/_icon.html.twig' as ui %}
<h1 class="mb-6 flex items-center gap-2 text-2xl font-semibold"><span class="text-amber-600">{{ ui.icon(setup ? 'flame' : 'sliders', 'size-7') }}</span>{{ setup ? 'Mise en route' : 'Réglages' }}</h1>

{% if setup %}
<section aria-labelledby="mise-en-route" class="mb-10 rounded-lg border border-sky-300 bg-sky-50 p-5 text-sky-950">
    <h2 id="mise-en-route" class="mb-2 text-lg font-semibold">Bienvenue : réglez d’abord votre foyer</h2>
    <p class="mb-4 text-sm">Avant le premier relevé, l’outil a besoin de savoir <strong>où vous habitez</strong> (pour les prévisions), <strong>quelles pièces</strong> vous relevez, et <strong>quelle température</strong> vous visez. Trois étapes, dans l’ordre de la page :</p>
    <ol class="mb-5 space-y-2 text-sm">
        <li><span class="inline-flex align-text-bottom">{{ ui.icon(setup.hasCity ? 'check' : 'circle') }}</span> <a href="#ville" class="font-medium underline underline-offset-2">1. Votre ville</a> — {% if setup.hasCity %}faite : {{ household.city }}{% else %}à choisir{% endif %}</li>
        <li><span class="inline-flex align-text-bottom">{{ ui.icon(setup.placeCount > 0 ? 'check' : 'circle') }}</span> <a href="#lieux" class="font-medium underline underline-offset-2">2. Vos lieux</a> — {% if setup.placeCount > 0 %}{{ setup.placeCount }} déclaré{{ setup.placeCount > 1 ? 's' : '' }}{% else %}au moins un à déclarer{% endif %}</li>
        <li><span class="inline-flex align-text-bottom">{{ ui.icon('circle') }}</span> <a href="#cibles" class="font-medium underline underline-offset-2">3. Vos températures visées</a> — des valeurs vous sont proposées : relisez-les et ajustez-les</li>
    </ol>
    <form method="post" action="{{ path('app_setup_finish') }}" class="max-w-md">
        <input type="hidden" name="_token" value="{{ csrf_token('finish-setup') }}">
        <button type="submit" {% if not setup.isComplete %}disabled aria-describedby="reste-a-faire"{% endif %}
                class="w-full rounded-md bg-slate-900 px-4 py-3 font-medium text-white hover:bg-slate-700 focus:outline-2 focus:outline-offset-2 focus:outline-slate-900 disabled:cursor-not-allowed disabled:bg-slate-400 disabled:text-slate-900">Terminer la mise en route et saisir un relevé</button>
        {% if not setup.isComplete %}
            <p id="reste-a-faire" class="mt-2 text-sm">Il reste à faire : {{ setup.missing|join(', ') }}.</p>
        {% endif %}
    </form>
</section>
{% endif %}

<section aria-labelledby="ville" class="mb-6 rounded-xl border border-slate-200 bg-white p-5">
    <h2 id="ville" class="mb-2 flex items-center gap-2 text-lg font-semibold">{{ ui.icon('pin', 'size-5') }}{{ setup ? '1. ' : '' }}Votre ville</h2>
    <p class="mb-4 text-sm text-slate-700">
        {% if household.city %}
            Ville actuelle : <strong>{{ household.city }}</strong>. Les prévisions de température en dépendent.
        {% else %}
            Aucune ville renseignée. Elle sert à récupérer les prévisions de température.
        {% endif %}
    </p>

    <form method="get" action="{{ path('app_settings') }}" class="mb-4 flex max-w-md items-end gap-3" role="search">
        <div class="grow">
            <label for="q" class="mb-1 block text-sm font-medium text-slate-800">Rechercher une ville ou un code postal</label>
            <input type="search" id="q" name="q" value="{{ query }}" minlength="2" maxlength="80" required autocomplete="off"
                   class="block w-full min-h-11 rounded-md border border-slate-500 bg-white placeholder:text-slate-500 px-3 py-2 shadow-sm focus:border-slate-900 focus:outline-2 focus:outline-offset-2 focus:outline-slate-900">
        </div>
        <button type="submit" class="min-h-11 rounded-md bg-slate-900 px-4 py-2 font-medium text-white hover:bg-slate-700 focus:outline-2 focus:outline-offset-2 focus:outline-slate-900"><span class="inline-flex items-center gap-2">{{ ui.icon('search') }}Rechercher</span></button>
    </form>

    {% if searchError %}
        <p role="alert" class="mb-4 rounded-md border border-red-300 bg-red-50 px-4 py-3 text-sm text-red-900">{{ searchError }}</p>
    {% elseif query is not empty %}
        {% if results is empty %}
            <p role="status" class="text-sm text-slate-700">Aucune ville ne correspond à « {{ query }} ».</p>
        {% else %}
            <p id="resultats" class="mb-2 text-sm text-slate-700">{{ results|length }} résultat{{ results|length > 1 ? 's' : '' }} : choisissez votre ville.</p>
            <ul aria-labelledby="resultats" class="max-w-md divide-y divide-slate-200 rounded-lg border border-slate-200 bg-white">
                {% for place in results %}
                    <li class="flex items-center justify-between gap-3 px-4 py-3">
                        <span>{{ place.label }}</span>
                        <form method="post" action="{{ path('app_settings_city') }}">
                            <input type="hidden" name="_token" value="{{ csrf_token('choose-city') }}">
                            <input type="hidden" name="label" value="{{ place.label }}">
                            <input type="hidden" name="latitude" value="{{ place.latitude }}">
                            <input type="hidden" name="longitude" value="{{ place.longitude }}">
                            <input type="hidden" name="timezone" value="{{ place.timezone }}">
                            <button type="submit" class="inline-flex min-h-11 items-center rounded px-2 text-sm font-medium text-slate-900 underline underline-offset-2 focus:outline-2 focus:outline-offset-2 focus:outline-slate-900">
                                Choisir<span class="sr-only"> {{ place.label }}</span>
                            </button>
                        </form>
                    </li>
                {% endfor %}
            </ul>
        {% endif %}
    {% endif %}
    <p class="mt-3 text-xs text-slate-500">Recherche fournie par Open-Meteo ; données de localisation GeoNames.</p>
</section>

<section id="lieux" aria-labelledby="titre-lieux" class="mb-6 rounded-xl border border-slate-200 bg-white p-5">
    <h2 id="titre-lieux" class="mb-2 flex items-center gap-2 text-lg font-semibold">{{ ui.icon('home', 'size-5') }}{{ setup ? '2. ' : '' }}Vos lieux</h2>
    <p class="mb-4 max-w-2xl text-sm text-slate-700">Les pièces où vous relevez la température. À chaque relevé, vous renseignez <strong>tous</strong> ces lieux : la moyenne et les recommandations reposent sur eux.</p>

    {% if places is empty %}
        <p class="mb-4 text-sm text-slate-600">Aucun lieu déclaré pour le moment.</p>
    {% else %}
        <ul class="mb-4 max-w-2xl divide-y divide-slate-200 rounded-lg border border-slate-200 bg-white">
            {% for place in places %}
                <li class="flex flex-wrap items-end gap-3 px-4 py-3">
                    <span class="mb-2.5 text-slate-700">{{ ui.icon(place_icon(place.name), 'size-5') }}</span>
                    <form method="post" action="{{ path('app_place_rename', {id: place.id}) }}" class="flex grow items-end gap-2">
                        <input type="hidden" name="_token" value="{{ csrf_token('place-rename-' ~ place.id) }}">
                        <div class="grow">
                            <label for="lieu-{{ place.id }}" class="sr-only">Nom du lieu</label>
                            <input type="text" id="lieu-{{ place.id }}" name="name" value="{{ place.name }}" maxlength="80" required
                                   class="block w-full min-h-11 rounded-md border border-slate-500 bg-white placeholder:text-slate-500 px-3 py-1.5 shadow-sm focus:border-slate-900 focus:outline-2 focus:outline-offset-2 focus:outline-slate-900">
                        </div>
                        <button type="submit" class="inline-flex min-h-11 items-center rounded px-2 text-sm text-slate-800 gap-1.5 underline underline-offset-2 hover:text-slate-950 focus:outline-2 focus:outline-offset-2 focus:outline-slate-900">{{ ui.icon('pencil') }}Renommer<span class="sr-only"> {{ place.name }}</span></button>
                    </form>
                    <form method="post" action="{{ path('app_place_delete', {id: place.id}) }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('place-delete-' ~ place.id) }}">
                        <button type="submit" class="inline-flex min-h-11 items-center rounded px-2 text-sm text-slate-800 gap-1.5 underline underline-offset-2 hover:text-red-700 focus:outline-2 focus:outline-offset-2 focus:outline-slate-900">{{ ui.icon('trash') }}Supprimer<span class="sr-only"> {{ place.name }}</span></button>
                    </form>
                </li>
            {% endfor %}
        </ul>
        <p class="mb-4 text-xs text-slate-500">Supprimer un lieu supprime aussi tous ses relevés.</p>
    {% endif %}

    <form method="post" action="{{ path('app_place_add') }}" class="max-w-md" data-controller="place">
        <input type="hidden" name="_token" value="{{ csrf_token('place-add') }}">
        <label for="nouveau-lieu" class="mb-1 block text-sm font-medium text-slate-800">Ajouter un lieu</label>
        <select id="nouveau-lieu" name="choice" required data-place-target="select" data-action="change->place#toggle"
                class="mb-3 block w-full min-h-11 rounded-md border border-slate-500 bg-white placeholder:text-slate-500 px-3 py-2 text-slate-900 shadow-sm focus:border-slate-900 focus:outline-2 focus:outline-offset-2 focus:outline-slate-900">
            <option value="">Choisir un lieu</option>
            {% for group, choices in placeChoices %}
                <optgroup label="{{ group }}">
                    {% for label, value in choices %}<option value="{{ value }}">{{ label }}</option>{% endfor %}
                </optgroup>
            {% endfor %}
        </select>
        <div data-place-target="custom" class="mb-3">
            <label for="nom-lieu" class="mb-1 block text-sm font-medium text-slate-800">Nom du lieu</label>
            <input type="text" id="nom-lieu" name="custom" maxlength="80" placeholder="Atelier, chambre 2…"
                   class="block w-full min-h-11 rounded-md border border-slate-500 bg-white placeholder:text-slate-500 px-3 py-2 shadow-sm focus:border-slate-900 focus:outline-2 focus:outline-offset-2 focus:outline-slate-900">
        </div>
        {% include 'partials/_button.html.twig' with {label: 'Ajouter ce lieu', icon: 'plus'} %}
    </form>
</section>

<section aria-labelledby="cibles" class="mb-6 rounded-xl border border-slate-200 bg-white p-5">
    <h2 id="cibles" class="mb-2 flex items-center gap-2 text-lg font-semibold">{{ ui.icon('target', 'size-5') }}{{ setup ? '3. ' : '' }}Températures visées du foyer</h2>
    <p class="mb-4 max-w-2xl text-sm text-slate-700">Température intérieure en dessous de laquelle vous souhaitez chauffer, pour chaque moment de chaque jour de la semaine (par exemple plus bas en semaine quand la maison est vide). Matin 6 h – 12 h, après-midi 12 h – 18 h, soirée 18 h – 22 h, nuit 22 h – 6 h le lendemain.</p>

    {{ form_start(form, {attr: {novalidate: 'novalidate'}}) }}
        {{ form_errors(form) }}
        {% set rows = [] %}
        {% for day in weekdays %}
            {% set dayForm = attribute(form, day.key) %}
            {% set fields = {} %}
            {% for slot in slots %}{% set fields = fields|merge({(slot.value): attribute(dayForm, slot.value)}) %}{% endfor %}
            {% set rows = rows|merge([{id: 'jour-' ~ day.key, label: day.label, fields: fields}]) %}
        {% endfor %}
        {% include 'settings/_target_grid.html.twig' with {rows: rows, slots: slots, corner: 'Jour'} %}
        <div class="max-w-xs">{% include 'partials/_button.html.twig' with {label: 'Enregistrer les températures du foyer', icon: 'check'} %}</div>
    {{ form_end(form) }}
</section>

{% if places is not empty %}
<section id="cibles-pieces" aria-labelledby="titre-cibles-pieces" class="rounded-xl border border-slate-200 bg-white p-5">
    <h2 id="titre-cibles-pieces" class="mb-2 flex items-center gap-2 text-lg font-semibold">{{ ui.icon('sliders', 'size-5') }}Températures visées par pièce</h2>
    <p class="mb-4 max-w-2xl text-sm text-slate-700">Facultatif. Une température saisie ici <strong>remplace celle du foyer</strong> pour cette pièce et ce moment de la journée, tous les jours de la semaine (par exemple une chambre à 17 °C la nuit). Laissez vide pour que la pièce suive le foyer.</p>

    {{ form_start(placeForm, {attr: {novalidate: 'novalidate'}}) }}
        {{ form_errors(placeForm) }}
        {% set placeRows = [] %}
        {% for place in places %}
            {% set placeFields = attribute(placeForm, 'p' ~ place.id) %}
            {% set fields = {} %}
            {% for slot in slots %}{% set fields = fields|merge({(slot.value): attribute(placeFields, slot.value)}) %}{% endfor %}
            {% set placeRows = placeRows|merge([{id: 'piece-' ~ place.id, label: place.name, icon: place_icon(place.name), fields: fields}]) %}
        {% endfor %}
        {% include 'settings/_target_grid.html.twig' with {rows: placeRows, slots: slots, corner: 'Pièce'} %}
        <div class="max-w-xs">{% include 'partials/_button.html.twig' with {label: 'Enregistrer les températures par pièce', icon: 'check'} %}</div>
    {{ form_end(placeForm) }}
</section>
{% endif %}
{% endblock %}
