{% extends 'base.html.twig' %}

{% block title %}Réglages{% endblock %}

{% block body %}
<h1 class="mb-6 text-2xl font-semibold">Réglages</h1>

<section aria-labelledby="ville" class="mb-10">
    <h2 id="ville" class="mb-2 text-lg font-semibold">Votre ville</h2>
    <p class="mb-4 text-sm text-slate-700">
        {% if household.city %}
            Ville actuelle : <strong>{{ household.city }}</strong>. Les prévisions de température en dépendent.
        {% else %}
            Aucune ville renseignée. Elle sert à récupérer les prévisions de température.
        {% endif %}
    </p>

    <form method="get" action="{{ path('app_settings') }}" class="mb-4 flex max-w-md items-end gap-3" role="search">
        <div class="grow">
            <label for="q" class="mb-1 block text-sm font-medium text-slate-800">Rechercher une ville ou un code postal</label>
            <input type="search" id="q" name="q" value="{{ query }}" minlength="2" maxlength="80" required autocomplete="off"
                   class="block w-full rounded-md border border-slate-500 bg-white placeholder:text-slate-500 px-3 py-2 shadow-sm focus:border-slate-900 focus:outline-2 focus:outline-offset-2 focus:outline-slate-900">
        </div>
        <button type="submit" class="rounded-md bg-slate-900 px-4 py-2 font-medium text-white hover:bg-slate-700 focus:outline-2 focus:outline-offset-2 focus:outline-slate-900">Rechercher</button>
    </form>

    {% if searchError %}
        <p role="alert" class="mb-4 rounded-md border border-red-300 bg-red-50 px-4 py-3 text-sm text-red-900">{{ searchError }}</p>
    {% elseif query is not empty %}
        {% if results is empty %}
            <p role="status" class="text-sm text-slate-700">Aucune ville ne correspond à « {{ query }} ».</p>
        {% else %}
            <p id="resultats" class="mb-2 text-sm text-slate-700">{{ results|length }} résultat{{ results|length > 1 ? 's' : '' }} : choisissez votre ville.</p>
            <ul aria-labelledby="resultats" class="max-w-md divide-y divide-slate-200 rounded-lg border border-slate-200 bg-white">
                {% for place in results %}
                    <li class="flex items-center justify-between gap-3 px-4 py-3">
                        <span>{{ place.label }}</span>
                        <form method="post" action="{{ path('app_settings_city') }}">
                            <input type="hidden" name="_token" value="{{ csrf_token('choose-city') }}">
                            <input type="hidden" name="label" value="{{ place.label }}">
                            <input type="hidden" name="latitude" value="{{ place.latitude }}">
                            <input type="hidden" name="longitude" value="{{ place.longitude }}">
                            <input type="hidden" name="timezone" value="{{ place.timezone }}">
                            <button type="submit" class="rounded text-sm font-medium text-slate-900 underline underline-offset-2 focus:outline-2 focus:outline-offset-2 focus:outline-slate-900">
                                Choisir<span class="sr-only"> {{ place.label }}</span>
                            </button>
                        </form>
                    </li>
                {% endfor %}
            </ul>
        {% endif %}
    {% endif %}
    <p class="mt-3 text-xs text-slate-500">Recherche fournie par Open-Meteo ; données de localisation GeoNames.</p>
</section>

<section id="lieux" aria-labelledby="titre-lieux" class="mb-10">
    <h2 id="titre-lieux" class="mb-2 text-lg font-semibold">Vos lieux</h2>
    <p class="mb-4 max-w-2xl text-sm text-slate-700">Les pièces où vous relevez la température. À chaque relevé, vous renseignez <strong>tous</strong> ces lieux : la moyenne et les recommandations reposent sur eux.</p>

    {% if places is empty %}
        <p class="mb-4 text-sm text-slate-600">Aucun lieu déclaré pour le moment.</p>
    {% else %}
        <ul class="mb-4 max-w-2xl divide-y divide-slate-200 rounded-lg border border-slate-200 bg-white">
            {% for place in places %}
                <li class="flex flex-wrap items-end gap-3 px-4 py-3">
                    <form method="post" action="{{ path('app_place_rename', {id: place.id}) }}" class="flex grow items-end gap-2">
                        <input type="hidden" name="_token" value="{{ csrf_token('place-rename-' ~ place.id) }}">
                        <div class="grow">
                            <label for="lieu-{{ place.id }}" class="sr-only">Nom du lieu</label>
                            <input type="text" id="lieu-{{ place.id }}" name="name" value="{{ place.name }}" maxlength="80" required
                                   class="block w-full rounded-md border border-slate-500 bg-white placeholder:text-slate-500 px-3 py-1.5 shadow-sm focus:border-slate-900 focus:outline-2 focus:outline-offset-2 focus:outline-slate-900">
                        </div>
                        <button type="submit" class="rounded text-sm text-slate-800 underline underline-offset-2 hover:text-slate-950 focus:outline-2 focus:outline-offset-2 focus:outline-slate-900">Renommer<span class="sr-only"> {{ place.name }}</span></button>
                    </form>
                    <form method="post" action="{{ path('app_place_delete', {id: place.id}) }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('place-delete-' ~ place.id) }}">
                        <button type="submit" class="rounded text-sm text-slate-800 underline underline-offset-2 hover:text-red-700 focus:outline-2 focus:outline-offset-2 focus:outline-slate-900">Supprimer<span class="sr-only"> {{ place.name }}</span></button>
                    </form>
                </li>
            {% endfor %}
        </ul>
        <p class="mb-4 text-xs text-slate-500">Supprimer un lieu supprime aussi tous ses relevés.</p>
    {% endif %}

    <form method="post" action="{{ path('app_place_add') }}" class="max-w-md" data-controller="place">
        <input type="hidden" name="_token" value="{{ csrf_token('place-add') }}">
        <label for="nouveau-lieu" class="mb-1 block text-sm font-medium text-slate-800">Ajouter un lieu</label>
        <select id="nouveau-lieu" name="choice" required data-place-target="select" data-action="change->place#toggle"
                class="mb-3 block w-full rounded-md border border-slate-500 bg-white placeholder:text-slate-500 px-3 py-2 text-slate-900 shadow-sm focus:border-slate-900 focus:outline-2 focus:outline-offset-2 focus:outline-slate-900">
            <option value="">Choisir un lieu</option>
            {% for group, choices in placeChoices %}
                <optgroup label="{{ group }}">
                    {% for label, value in choices %}<option value="{{ value }}">{{ label }}</option>{% endfor %}
                </optgroup>
            {% endfor %}
        </select>
        <div data-place-target="custom" class="mb-3">
            <label for="nom-lieu" class="mb-1 block text-sm font-medium text-slate-800">Nom du lieu</label>
            <input type="text" id="nom-lieu" name="custom" maxlength="80" placeholder="Atelier, chambre 2…"
                   class="block w-full rounded-md border border-slate-500 bg-white placeholder:text-slate-500 px-3 py-2 shadow-sm focus:border-slate-900 focus:outline-2 focus:outline-offset-2 focus:outline-slate-900">
        </div>
        {% include 'partials/_button.html.twig' with {label: 'Ajouter ce lieu'} %}
    </form>
</section>

<section aria-labelledby="cibles">
    <h2 id="cibles" class="mb-2 text-lg font-semibold">Températures visées</h2>
    <p class="mb-4 max-w-2xl text-sm text-slate-700">Température intérieure en dessous de laquelle vous souhaitez chauffer, pour chaque moment de chaque jour de la semaine (par exemple plus bas en semaine quand la maison est vide). Matin 6 h – 12 h, après-midi 12 h – 18 h, soirée 18 h – 22 h, nuit 22 h – 6 h le lendemain.</p>

    {{ form_start(form, {attr: {novalidate: 'novalidate'}}) }}
        {{ form_errors(form) }}
        <div class="mb-5 overflow-x-auto rounded-lg border border-slate-200 bg-white">
            <table class="w-full text-left text-sm">
                <caption class="sr-only">Température visée en °C, par jour de la semaine et par moment de la journée</caption>
                <thead class="bg-slate-100 text-slate-700">
                    <tr>
                        <th scope="col" class="px-4 py-3 font-semibold">Jour</th>
                        {% for slot in slots %}
                            <th scope="col" class="px-4 py-3 font-semibold">{{ slot.label }}</th>
                        {% endfor %}
                    </tr>
                </thead>
                <tbody>
                    {% for day in weekdays %}
                        {% set dayForm = attribute(form, day.key) %}
                        <tr class="border-t border-slate-100">
                            <th scope="row" class="px-4 py-2 font-medium">{{ day.label }}</th>
                            {% for slot in slots %}
                                {% set field = attribute(dayForm, slot.value) %}
                                <td class="px-3 py-2 align-top">
                                    <label for="{{ field.vars.id }}" class="sr-only">{{ day.label }}, {{ slot.label|lower }}, température visée en degrés</label>
                                    {{ form_widget(field, {attr: {class: 'w-24'}}) }}
                                    {{ form_errors(field) }}
                                </td>
                            {% endfor %}
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
        <div class="max-w-xs">{% include 'partials/_button.html.twig' with {label: 'Enregistrer'} %}</div>
    {{ form_end(form) }}
</section>
{% endblock %}
