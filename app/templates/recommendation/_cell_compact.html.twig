{# Case resserrée pour la vue pièce par pièce. #}
{% if item.action.value == 'unknown' %}
    <span aria-label="pas de recommandation">—</span>
{% else %}
    {% if item.action.value == 'heat' %}
        <span class="inline-block rounded bg-amber-100 px-2 py-0.5 text-xs font-semibold text-amber-900">Chauffer à {{ item.setpoint|number_format(1, ',') }} °C</span>
    {% else %}
        <span class="inline-block rounded bg-emerald-100 px-2 py-0.5 text-xs font-semibold text-emerald-900">Couper</span>
    {% endif %}
    <span class="mt-1 block text-xs text-slate-600">dedans ≈ {{ item.estimatedIndoor|round|number_format(0, ',') }} °C{% if item.extrapolated %}<span title="Hors plage mesurée : estimation moins fiable"> *</span>{% endif %}</span>
{% endif %}
