{# Phrase de synthèse d'un créneau. #}
{% if item.action.value == 'heat' %}
    <strong class="text-amber-800">Attention, les températures sont de {{ item.outdoor|number_format(1, ',') }} °C : il faut mettre le chauffage à {{ item.setpoint|number_format(1, ',') }} °C.</strong>
{% elseif item.action.value == 'cut' %}
    <strong class="text-emerald-800">Les températures ({{ item.outdoor|number_format(1, ',') }} °C) permettent de couper le chauffage.</strong>
{% else %}
    <span class="text-slate-600">Pas assez d’éléments pour conclure.</span>
{% endif %}
