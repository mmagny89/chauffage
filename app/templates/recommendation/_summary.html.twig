{# Résumé d'un créneau, en une ligne : l'action, puis la température extérieure prévue. #}
{% import 'partials/_icon.html.twig' as ui %}
{% if item.action.value == 'heat' %}
    <span class="inline-flex flex-wrap items-center gap-x-1.5 text-amber-800">{{ ui.icon('flame', 'size-4') }}<strong>Chauffer{% if not item.heatingOn %} à {{ item.setpoint|number_format(1, ',') }} °C{% endif %}</strong> <span class="text-slate-600">· {{ item.outdoor|number_format(1, ',') }} °C dehors</span>{% if item.warmUpMinutes is not null %} <span class="text-slate-600">· ≈ {{ item.warmUpMinutes|duration }} pour y arriver</span>{% endif %}</span>
{% elseif item.action.value == 'cut' %}
    <span class="inline-flex flex-wrap items-center gap-x-1.5 text-emerald-800">{{ ui.icon('power', 'size-4') }}<strong>Couper</strong> <span class="text-slate-600">· {{ item.outdoor|number_format(1, ',') }} °C dehors</span></span>
{% else %}
    <span class="inline-flex items-center gap-1.5 text-slate-600">{{ ui.icon('help', 'size-4') }}Pas de recommandation</span>
{% endif %}
