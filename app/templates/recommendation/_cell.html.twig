{% import 'partials/_icon.html.twig' as ui %}
{% if item.action.value == 'unknown' %}
    <span aria-label="pas de recommandation" class="inline-flex items-center gap-1 text-slate-500">{{ ui.icon('help') }}<span aria-hidden="true">—</span></span>
{% else %}
    {% include 'recommendation/_badge.html.twig' %}
    <span class="mt-1 flex items-center gap-1 text-xs text-slate-600">{{ ui.icon('sun', 'size-3.5') }}dehors {{ item.outdoor|number_format(1, ',') }} °C</span>
    <span class="flex items-center gap-1 text-xs text-slate-600">{{ ui.icon('home', 'size-3.5') }}dedans ≈ {{ item.estimatedIndoor|round|number_format(0, ',') }} °C</span>
    <span class="flex items-center gap-1 text-xs text-slate-500">{{ ui.icon('target', 'size-3.5') }}visé {{ item.target|number_format(1, ',') }} °C</span>
    {% if item.extrapolated %}<span class="flex items-center gap-1 text-xs text-amber-700" title="La prévision sort des températures extérieures relevées : l’estimation est moins fiable. Faites des relevés à ces températures.">{{ ui.icon('alert', 'size-3.5') }}hors plage mesurée</span>{% endif %}
    {% if item.deltaIsFallback %}<span class="block text-xs text-slate-500" title="Aucun relevé sur ce créneau : modèle de tous les créneaux">écart général</span>{% endif %}
{% endif %}
